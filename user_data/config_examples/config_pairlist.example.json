{
    "pairlists": [
        // 1. Create a large universe of liquid pairs
        {
            "method": "VolumePairList",
            "sort_key": "quoteVolume",
            "refresh_period": 1800,
            "number_assets": 60
        },
        // 2. Apply various SAFETY filters (these remove bad pairs)
        {
            "method": "AgeFilter",
            "min_days_listed": 90
        },
        {
            "method": "PriceFilter",
            "low_price_ratio": 0.001
        },
        {
            "method": "SpreadFilter",
            "max_spread_ratio": 0.004
        },
        {
            "method": "VolatilityFilter",
            "min_volatility": 0.015,
            "max_volatility": 0.45,
            "refresh_period": 1800
        },
        {
            "method": "RangeStabilityFilter",
            "lookback_days": 5, // REMOVED THE DUPLICATE PARAMETER
            "min_rate_of_change": 0.02,
            "refresh_period": 1800
        },
        {
            "method": "PrecisionFilter" // Safety filter
        },
        // 3. FINALLY, apply the filter that limits the number <<< MOST IMPORTANT
        // This must be the last filter that changes the number of assets.
        {
            "method": "PerformanceFilter",
            "number_assets": 10, // This is the final gate
            "lookback_period": 2880, // CORRECTED PARAMETER (from "minutes")
            "sort_key": "profit", // Or use your FreqAI prediction column
            "min_periods": 48
        }
        // 4. ShuffleFilter is REMOVED entirely
    ]
}
