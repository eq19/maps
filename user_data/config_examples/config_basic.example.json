{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "fee": 0.003733,
  "max_open_trades": -1,
  "trading_mode": "spot",
  "stake_currency": "IDR",
  "stake_amount": 250000,
  "dry_run_wallet": 2500000,
  "startup_candle_count": 120,
  "fiat_display_currency": "IDR",
  "tradable_balance_ratio": 0.99,
  "reduce_df_footprint": false,
  "disable_dataframe_checks": false,
  "cancel_open_orders_on_exit": true,
  "process_only_new_candles": false,
  "ignore_roi_if_entry_signal": false,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "market",
    "force_entry": "market",
    "force_exit": "market",
    "stoploss": "market",
    "stoploss_on_exchange": false,
    "stoploss_on_exchange_interval": 60
  },
  "edge": {
    "enabled": false,
    "process_throttle_secs": 604800,
    "calculate_since_number_of_days": 150,
    "allowed_risk": 0.005,
    "stoploss_range_min": -0.01,
    "stoploss_range_max": -0.6,
    "stoploss_range_step": -0.05,
    "minimum_winrate": 0.38,
    "minimum_expectancy": 0.08,
    "min_trade_number": 5,
    "max_trade_duration_minute": 1209600,
    "remove_pumps": false
  },
  "telegram": {
    "enabled": false,
    "token": "your_telegram_token",
    "chat_id": "your_telegram_chat_id",
    "notification_settings": {
      "status": "on",
      "warning": "on",
      "startup": "on",
      "entry": "on",
      "entry_fill": "on",
      "exit": {
        "roi": "off",
        "emergency_exit": "off",
        "force_exit": "off",
        "exit_signal": "off",
        "trailing_stop_loss": "off",
        "stop_loss": "off",
        "stoploss_on_exchange": "off",
        "custom_exit": "off"
      },
      "exit_fill": "on",
      "entry_cancel": "on",
      "exit_cancel": "on",
      "protection_trigger": "off",
      "protection_trigger_global": "on",
      "show_candle": "off"
    },
    "timeout": 60,
    "reload": true,
    "read_timeout": 30,
    "connect_timeout": 30,
    "poll_interval": 10.0,
    "balance_dust_level": 0.01
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "CORS_origins": [],
    "username": "YourUsername",
    "password": "YourPassword",
    "ws_token": "secret_ws_t0ken.",
    "jwt_secret_key": "some-random-key"
  },
  "external_message_consumer": {
    "enabled": false,
    "producers": [
      {
        "name": "default",
        "host": "127.0.0.2",
        "port": 8080,
        "ws_token": "secret_ws_t0ken."
      }
    ],
    "wait_timeout": 300,
    "ping_timeout": 10,
    "sleep_time": 10,
    "remove_entry_exit_signals": false,
    "message_size_limit": 8
  },
  "bot_name": "freqtrade",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5,
    "heartbeat_interval": 60
  },
  "strategy": "Fibbo",
  "use_exit_signal": true,
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather",
  "recursive_strategy_search": false,
  "db_url": "sqlite:///tradesv3.sqlite",
  "add_config_files": [
    "config_examples/config_freqai.example.json",
    "config_examples/config_pairlist.example.json",
    "config_examples/config_hyperopt.example.json",
    "config_examples/config_exchange.example.json"
  ]
}
