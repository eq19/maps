{
  "freqai": {
    "enabled": true,
    "identifier": "indodax-15m-v2",
    "purge_old_models": 1,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "live_retrain_hours": 24,
    "feature_parameters": {
      "include_timeframes": [
        "15m",
        "1h",
        "4h"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 24,
      "include_shifted_candles": 5,
      "indicator_periods_candles": [
        12,
        24,
        48
      ],
      "DI_threshold": 0.75,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "random_state": 42
    },
    "model_training_parameters": {
      "learning_rate": 3e-4,
      "trainer_kwargs": {
        "n_steps": 5000,
        "batch_size": 64,
        "n_epochs": null
      },
      "model_kwargs": {
        "hidden_dim": 512,
        "dropout_percent": 0.2,
        "n_layer": 1
      }
    }
  }
}
