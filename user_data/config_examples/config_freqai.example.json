{
  "freqai": {
    "enabled": true,
    "identifier": "indodax-15m-24h-v1",

    "purge_old_models": 1,

    "train_period_days": 30,
    "backtest_period_days": 7,

    "live_retrain_hours": 24,

    "rl_config": {
      "train_cycles": 25,
      "cpu_count": 1,
      "model_type": "PPO",
      "policy_type": "MlpPolicy",

      "max_trade_duration_candles": 300,
      "max_training_drawdown_pct": 0.02,

      "model_reward_parameters": {
        "rr": 1,
        "profit_aim": 0.025
      }
    },
    
    "feature_parameters": {
      "include_timeframes": ["15m"],

      "include_corr_pairlist": [],
      "label_period_candles": 96,

      "include_shifted_candles": 5,
      "indicator_periods_candles": [12,24,48],

      "DI_threshold": 0.75,
      "weight_factor": 0.9,

      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": true,

      "plot_feature_importances": 0
    },

    "data_split_parameters": {
      "test_size": 0,
      "random_state": 42
    },

    "model_training_parameters": {
      "learning_rate": 0.0003,

      "trainer_kwargs": {
        "n_steps": 10000,
        "batch_size": 128
      },

      "model_kwargs": {
        "hidden_dim": 256,
        "dropout_percent": 0.2,
        "n_layer": 2
      }
    }
  }
}
