{
  "enable_protections": true,
  "position_stacking": false,
  "disableparamexport": false,
  "hyperopt_jobs": 32,
  "hyperopt_min_trades": 150,
  "print_all": true,
  "max_generated_candidates": 100,
  "max_parallel_backtest": 8,
  "pipelines": [
    {
      "id": 1,
      "description": "Optimize buy, sell, and ROI logic (last 30 days)",
      "type": "hyperopt_optimize",
      "timeframe": "1m",
      "days": 30,
      "epochs": 100,
      "spaces": ["buy", "sell", "roi"],
      "hyperopt_loss": "SharpeHyperOptLoss",
      "parallel_jobs": 4
    },
    {
      "id": 2,
      "description": "Optimize ROI, protection, and trailing for profit management (last 60 days)",
      "type": "hyperopt_optimize",
      "timeframe": "1m",
      "days": 60,
      "epochs": 500,
      "spaces": ["roi", "protection", "trailing"],
      "hyperopt_loss": "ShortTradeDurHyperOptLoss",
      "parallel_jobs": 4
    },
    {
      "id": 3,
      "description": "Optimize protection, stoploss, and trade parameters (last 90 days)",
      "type": "hyperopt_optimize",
      "timeframe": "1m",
      "days": 90,
      "epochs": 1000,
      "spaces": ["protection", "stoploss", "trades"],
      "hyperopt_loss": "OnlyProfitHyperOptLoss",
      "parallel_jobs": 4
    },
    {
      "id": 4,
      "description": "Refine protection, stoploss, and trailing parameters for risk management (last 120 days)",
      "type": "hyperopt_optimize",
      "timeframe": "1m",
      "days": 120,
      "epochs": 1500,
      "spaces": ["protection", "stoploss", "trailing"],
      "hyperopt_loss": "MaxDrawDownHyperOptLoss",
      "parallel_jobs": 4
    },
    {
      "id": 5,
      "description": "Comprehensive optimization with all parameters (last 180 days)",
      "type": "hyperopt_optimize",
      "timeframe": "1m",
      "days": 180,
      "epochs": 2500,
      "spaces": ["all"],
      "hyperopt_loss": "ExpectancyHyperOptLoss",
      "parallel_jobs": 4
    }
  ]
}
