{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 5,
    "stake_currency": "IDR",
    "stake_amount": 100000,
    "tradable_balance_ratio": 0.25,
    "fiat_display_currency": "IDR",
    "timeframe": "1m",
    "dry_run": true,
    "dry_run_wallet": 400000,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "indodax",
        "key": "your_exchange_key",
        "secret": "your_exchange_secret",
        "ccxt_config": {
            "timeframes": {
                "1m": "1",
                "15m": "15",
                "30m": "30",
                "1h": "60",
                "4h": "240",
                "1d": "1D"
            }
        }
    },
    "pairlists": [
        {
            "method": "StaticPairList",
            "pairs": [
                "BTC/IDR",
                "ETH/IDR",
                "USDT/IDR"
            ]
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "your_telegram_token",
        "chat_id": "your_telegram_chat_id"
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080
    },
    "bot_name": "freqtrade",
    "db_url": "sqlite:///tradesv3.sqlite",
    "initial_state": "running",
    "strategy": "FreqaiExampleStrategy",
    "freqai": {
        "enabled": true,
        "models": {
            "default": {
                "class": "LightGBMRegressor",
                "config": {
                    "num_leaves": 31,
                    "learning_rate": 0.05,
                    "n_estimators": 100
                }
            }
        },
        "train_period": "90d",
        "min_train_period": "30d",
        "retrain_interval": "7d",
        "lookahead_period": "1d",
        "prediction_length": "3d",
        "feature_parameters": {
            "target": "close",
            "features": [
                "close",
                "open",
                "high",
                "low",
                "volume"
            ],
            "normalize": true,
            "include_timeframes": ["5m"],
            "include_corr_pairlist": [
                "BTC/IDR",
                "ETH/IDR"
            ],
            "indicator_periods_candles": {
                "sma": 20,
                "ema": 50,
                "rsi": 14
            }
        },
        "data_split_parameters": {
            "training_size": 0.8,
            "validation_size": 0.2
        },
        "feature_generation_parameters": {
            "rolling_windows": [
                {"feature": "close", "window_size": 14}
            ]
        },
        "prediction_parameters": {
            "method": "regression",
            "thresholds": {
                "buy": 0.5,
                "sell": 0.5
            }
        }
    }
}
