{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 5,
    "stake_currency": "IDR",
    "stake_amount": 100000,
    "tradable_balance_ratio": 0.25,
    "fiat_display_currency": "IDR",
    "timeframe": "1m",
    "dry_run": true,
    "dry_run_wallet": 400000,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "indodax",
        "key": "your_exchange_key",
        "secret": "your_exchange_secret",
        "ccxt_config": {
            "timeframes": {
                "1m": "1",
                "15m": "15",
                "30m": "30",
                "1h": "60",
                "4h": "240",
                "1d": "1D",
                "3d": "3D",
                "1w": "1W"
            }
        },
        "ccxt_async_config": {
            "has": {
                "spot": true,
                "createOrder": true,
                "fetchBalance": true,
                "fetchClosedOrders": true,
                "fetchMarkets": true,
                "fetchOpenOrders": true,
                "fetchOrderBook": true,
                "fetchTicker": true,
                "fetchTickers": true,
                "fetchTime": true,
                "fetchTrades": true,
                "withdraw": true
            }
        },
        "pair_whitelist": [
            "BTC/IDR",
            "ETH/IDR",
            "USDT/IDR"
        ],
        "pair_blacklist": [
            "^.*ETH/BTC$"
        ]
    },
    "pairlists": [
        {
            "method": "StaticPairList",
            "pairs": [
                "BTC/IDR",
                "ETH/IDR",
                "USDT/IDR"
            ]
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "your_telegram_token",
        "chat_id": "your_telegram_chat_id",
        "notification_settings": {
            "status": "on",
            "warning": "on",
            "startup": "on",
            "entry": "on",
            "entry_fill": "on",
            "exit": {
                "roi": "off",
                "emergency_exit": "off",
                "force_exit": "off",
                "exit_signal": "off",
                "trailing_stop_loss": "off",
                "stop_loss": "off",
                "stoploss_on_exchange": "off",
                "custom_exit": "off"
            },
            "exit_fill": "on",
            "entry_cancel": "on",
            "exit_cancel": "on",
            "protection_trigger": "off",
            "protection_trigger_global": "on",
            "show_candle": "off"
        },
        "reload": true,
        "balance_dust_level": 0.01
    },
    "api_server": {
        "enabled": false,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "somethingrandom",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "SuperSecurePassword",
        "ws_token": "secret_ws_t0ken."
    },
    "bot_name": "freqtrade",
    "db_url": "sqlite:///tradesv3.sqlite",
    "initial_state": "running",
    "freqai": {
        "enabled": true,
        "models": {
            "default": {
                "class": "LightGBMRegressor",
                "config": {
                    "num_leaves": 31,
                    "learning_rate": 0.05,
                    "n_estimators": 100
                }
            }
        },
        "train_period": "90d",
        "min_train_period": "30d",
        "retrain_interval": "7d",
        "lookahead_period": "1d",
        "prediction_length": "3d",
        "feature_parameters": {
            "target": "close",
            "features": [
                "close",
                "open",
                "high",
                "low",
                "volume"
            ],
            "normalize": true,
            "include_timeframes": ["5m"],
            "include_corr_pairlist": [
                "BTC/IDR",
                "ETH/IDR"
            ],
            "include_shifted_candles": 0
        },
        "data_split_parameters": {
            "training_size": 0.8,
            "shuffle": true,
            "validation_size": 0.2
        },
        "feature_generation_parameters": {
            "rolling_windows": [
                {"feature": "close", "window_size": 14},
                {"feature": "volume", "window_size": 7}
            ]
        },
        "prediction_parameters": {
            "method": "regression",
            "thresholds": {
                "buy": 0.5,
                "sell": 0.5
            }
        }
    }
}
