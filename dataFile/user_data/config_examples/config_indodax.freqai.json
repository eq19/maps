{
    "freqai": {
        "enabled": true,
        "model": "LightGBMRegressor",
        "freqaimodel": "FreqaiLightGBMModel",
        "train_interval": "1h",
        "model_save_interval": "1d",
        "train_period": "90d",
        "min_train_period": "30d",
        "retrain_interval": "7d",
        "lookahead_period": "1d",
        "prediction_length": "3d",
        "feature_parameters": {
            "target": "close",
            "features": [
                "close",
                "open",
                "high",
                "low",
                "volume"
            ],
            "normalize": true,
            "include_timeframes": ["15m", "30m", "1h"],
            "label_period_candles": 10,
            "include_corr_pairlist": [
                "BTC/IDR",
                "ETH/IDR"
            ],
            "indicator_periods_candles": [14, 50, 200],
            "target_period_candles": 12
        },
        "data_split_parameters": {
            "training_size": 0.8,
            "validation_size": 0.2
        },
        "feature_generation_parameters": {
            "rolling_windows": [
                {"feature": "close", "window_size": 14}
            ]
        },
        "prediction_parameters": {
            "method": "regression",
            "thresholds": {
                "buy": 0.5,
                "sell": 0.5
            }
        }
    }        
}
