{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 3,
    "stake_currency": "IDR",
    "stake_amount": 100000,
    "exchange": {
        "name": "indodax",
        "key": "your_exchange_key",
        "secret": "your_exchange_secret",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/IDR",
            "ETH/IDR"
        ],
        "pair_blacklist": [
            "^.*ETH/BTC$"
        ]
    },
    "telegram": {
        "enabled": true,
        "token": "your_telegram_token",
        "chat_id": "your_telegram_chat_id"
    }
}
